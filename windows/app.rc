#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
1 ICON "icon.ico"
2 DIALOGEX 0, 0, 200, 52
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Speed"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", 11, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 4, 7, 138, 16
    EDITTEXT 10, 146, 8, 34, 14, ES_AUTOHSCROLL | ES_RIGHT
    LTEXT "×", -1, 183, 10, 10, 10
    DEFPUSHBUTTON "OK", IDOK, 89, 30, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 143, 30, 50, 14
END
